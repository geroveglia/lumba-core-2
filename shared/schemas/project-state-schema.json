// PROJECT STATE SCHEMA — LUMBA CORE v2.0
// 
// Este archivo define la estructura del state.json que vive en cada proyecto.
// Jarvis lee y escribe este archivo para trackear el progreso.
//
// Schema version: 2.0
// Última actualización: 2026-06-02

{
  // ─── META ───
  "schema_version": "2.0",
  "project": "string",           // slug del proyecto
  "project_name": "string",      // nombre legible
  "client": "string",            // slug del cliente
  "project_type": "A | B | C",   // Greenfield | Brownfield | Parcial
  "complexity": "S | M | L | XL",// según checklist MATRIZ-SQUADS.md
  "complexity_score": 0,          // puntaje 0-18 del checklist de 6 preguntas
  "created_at": "ISO-8601",
  "updated_at": "ISO-8601",
  
  // ─── FASE ACTUAL ───
  "current_phase": "BRIEF | PROPOSAL | DISCOVERY | TECH_STACK | DB_DESIGN | BRANDING | UX_UI | MARKETING | BUILD | QA | DEPLOY | POST_LAUNCH | DONE",
  "current_phase_started_at": "ISO-8601",
  "current_phase_agent": "string | null",  // session_id del agente activo
  
  // ─── FASES ───
  "phases": {
    "BRIEF": {
      "status": "pending | in_progress | completed | skipped",
      "started_at": "ISO-8601 | null",
      "completed_at": "ISO-8601 | null",
      "outputs": ["string"],
      "agent_sessions": ["string"],
      "model_used": "flash | pro | opus",
      "attempts": 0,
      "rejection_count": 0,
      "max_iterations": 3,
      "rejection_reasons": ["string"],
      "notes": "string | null"
    },
    "DB_DESIGN": {
      "status": "pending | in_progress | completed | skipped",
      "started_at": "ISO-8601 | null",
      "completed_at": "ISO-8601 | null",
      "outputs": ["string"],
      "decision": "relational | non_relational | null",  // qué tipo de DB se eligió
      "agent_sessions": ["string"],
      "model_used": "opus",      // SIEMPRE opus
      "attempts": 0,
      "notes": "string | null"
    },
    // ... (misma estructura para BRANDING, MARKETING, DISCOVERY, UX_UI, BUILD, QA, DEPLOY)
  },
  
  // ─── GATES ───
  // Cada fase tiene un gate. Si no pasa, no se avanza.
  "gates": {
    "DB_DESIGN": {
      "passed": false,
      "audited_at": "ISO-8601 | null",
      "audited_by": "string | null",  // session_id del auditor
      "blocking_issues": [
        {
          "issue": "string",
          "severity": "critical | high | medium | low",
          "resolved": false,
          "resolution": "string | null"
        }
      ],
      "devils_advocate_result": "proceed | resolve_before_proceed | reject | null"
    }
    // ... (misma estructura para cada fase que tenga gate)
  },
  
  // ─── APROBACIONES HUMANAS ───
  "approvals": [
    {
      "approval_id": "string",
      "timestamp": "ISO-8601",
      "phase": "string",
      "type": "phase_gate | deploy | scope_change | override",
      "approver": "string",      // nombre del humano
      "channel": "telegram | slack | discord",
      "what_was_approved": "string",
      "approved": true,
      "conditions": ["string"],  // condiciones para la aprobación
      "response_time_hours": 0   // cuánto tardó en responder
    }
  ],
  
  // ─── STACK DECISIONS ───
  "stack": {
    "decided": false,
    "type": "A | B | C | legacy | null",
    "frontend": "string | null",
    "backend": "string | null",
    "database": "string | null",
    "hosting": "string | null",
    "adr_path": "string | null",  // path al ADR de decisiones de stack
    "decided_at": "ISO-8601 | null"
  },
  
  // ─── BUDGET ───
  "budget": {
    "limit_usd": 50,             // límite diario en USD
    "spent_usd": 0,
    "spent_by_phase": {
      "DB_DESIGN": 0,
      "BRANDING": 0,
      "DISCOVERY": 0
      // ...
    },
    "last_check": "ISO-8601 | null",
    "alerts_sent": 0
  },
  
  // ─── INCIDENTES ───
  "incidents": [
    {
      "timestamp": "ISO-8601",
      "severity": "critical | high | medium | low",
      "description": "string",
      "agent_involved": "string",
      "resolved": false,
      "resolution": "string | null"
    }
  ],
  
  // ─── MÉTRICAS DEL PROYECTO ───
  "metrics": {
    "total_agent_sessions": 0,
    "total_approvals": 0,
    "total_audits_passed_first_try": 0,
    "total_audits_failed": 0,
    "time_from_brief_to_db_design_hours": 0,
    "time_from_brief_to_deploy_hours": 0,
    "corrections_post_entrega": 0
  }
}

// PROJECT STATE SCHEMA — LUMBA CORE v2.1
// 
// Este archivo define la estructura del state.json que vive en cada proyecto.
// Jarvis lee y escribe este archivo para trackear el progreso.
//
// Schema version: 2.1
// Última actualización: 2026-06-02
// Changelog v2.1:
//   - Agregadas fases PROJECT_ASSESSMENT y BOOTSTRAP
//   - Todas las fases definidas explícitamente (no más "// ...")
//   - Agregado estado "reopened" para fases
//   - Budget tracking por modelo y agente
//   - Gates definidos para todas las fases que lo requieren

{
  // ─── META ───
  "schema_version": "2.1",
  "project": "string",           // slug del proyecto (kebab-case)
  "project_name": "string",      // nombre legible
  "client": "string | null",     // slug del cliente (debe matchear carpeta en /clientes/). null si es proyecto interno.
  "project_type": "A | B | C",   // Greenfield | Brownfield | Parcial
  "complexity": "S | M | L | XL",// según checklist MATRIZ-SQUADS.md
  "complexity_score": 0,          // puntaje 0-18 del checklist de 6 preguntas
  "squad": ["string"],            // agentes asignados según MATRIZ-SQUADS.md
  "created_at": "ISO-8601",
  "updated_at": "ISO-8601",
  
  // ─── FASE ACTUAL ───
  "current_phase": "PROJECT_ASSESSMENT | BRIEF | PROPOSAL | DISCOVERY | TECH_STACK | DB_DESIGN | BOOTSTRAP | BRANDING | UX_UI | MARKETING | BUILD | QA | DEPLOY | POST_LAUNCH | DONE",
  "current_phase_started_at": "ISO-8601",
  "current_phase_agent": "string | null",  // session_id del agente activo
  
  // ─── FASES ───
  // Estados posibles: pending | in_progress | completed | skipped | reopened
  //   - reopened: la fase se completó pero se reabrió por error detectado post-cierre.
  //     Al reabrir, se resetea completed_at, se incrementa attempts, y se registra motivo en notes.

  // ─── GATES ───
  // Cada fase con gate tiene su entrada. Si no pasa, no se avanza.
  // Mapping: Fase → Gates aplicables (de QUALITY-GATES.md)
  //
  //   PROJECT_ASSESSMENT → (sin gate, es clasificación)
  //   BRIEF              → Strategy Gate
  //   PROPOSAL           → Client Gate, Scope/Risk Gate
  //   DISCOVERY          → Strategy Gate
  //   TECH_STACK         → Strategy Gate
  //   DB_DESIGN          → Software Gate, UX/Product Gate
  //   BOOTSTRAP          → (sin gate, es scaffolding automático)
  //   BRANDING           → Brand Gate, Strategy Gate
  //   UX_UI              → Design Gate, UX/Product Gate
  //   MARKETING          → Marketing Gate, Growth Gate (si aplica), Paid Media Gate (si aplica)
  //   BUILD              → Software Gate
  //   QA                 → Software Gate
  //   DEPLOY             → Software Gate, Client Gate
  //   POST_LAUNCH        → Reporting Gate
  //
  "gates": {
    "BRIEF": {
